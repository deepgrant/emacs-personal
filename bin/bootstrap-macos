#!/usr/bin/env bash
set -euo pipefail

bootstrap_repo_root="$(cd "$(dirname "$0")/.." && pwd)"
bootstrap_jdk18_url="https://download.java.net/java/GA/jdk18.0.2/f6ad4b4450fd4d298113270ec84f30ee/9/GPL/openjdk-18.0.2_macos-aarch64_bin.tar.gz"
bootstrap_jdk18_sha="1da591d9ab49c348d5a424975ae44ea940edf1c3b3b4456d0a3020758829799e"

if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
  echo "This bootstrap supports Apple Silicon macOS only." >&2
  exit 1
fi
if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is required." >&2
  exit 1
fi

# Preserve historical OpenJDK 18 independently because current Homebrew tools
# require the generic openjdk formula to advance to its supported version.
bootstrap_jdk18_parent="${HOME}/.local/share/jdks"
bootstrap_jdk18_home="${bootstrap_jdk18_parent}/jdk-18.0.2.jdk"
if [[ ! -x "${bootstrap_jdk18_home}/Contents/Home/bin/java" ]]; then
  mkdir -p "${bootstrap_jdk18_parent}"
  if [[ -x /opt/homebrew/opt/openjdk/bin/java ]] && \
     /opt/homebrew/opt/openjdk/bin/java -version 2>&1 | head -n 1 | grep -q '"18\.'; then
    ditto /opt/homebrew/opt/openjdk/libexec/openjdk.jdk "${bootstrap_jdk18_home}"
  else
    bootstrap_tmp="$(mktemp -d)"
    trap 'rm -rf "${bootstrap_tmp}"' EXIT
    curl -fL "${bootstrap_jdk18_url}" -o "${bootstrap_tmp}/openjdk18.tar.gz"
    echo "${bootstrap_jdk18_sha}  ${bootstrap_tmp}/openjdk18.tar.gz" | shasum -a 256 -c -
    tar -xzf "${bootstrap_tmp}/openjdk18.tar.gz" -C "${bootstrap_jdk18_parent}"
  fi
fi
if ! "${bootstrap_jdk18_home}/Contents/Home/bin/java" -version 2>&1 | head -n 1 | grep -q '"18\.0\.2'; then
  echo "Preserved OpenJDK 18 failed verification." >&2
  exit 1
fi
brew unpin openjdk 2>/dev/null || true

brew tap d12frosted/emacs-plus
brew tap coursier/formulas
brew trust d12frosted/emacs-plus
brew trust coursier/formulas
brew bundle --file "${bootstrap_repo_root}/Brewfile"
brew upgrade openjdk@17 openjdk@21 || true

bootstrap_node_bin="/opt/homebrew/opt/node@24/bin"
PATH="${bootstrap_node_bin}:${PATH}" \
  "${bootstrap_node_bin}/npm" ci --prefix "${bootstrap_repo_root}/tools"

mkdir -p "${bootstrap_repo_root}/.local/bin"
cs bootstrap org.scalameta:metals_2.13:1.6.8 \
  -o "${bootstrap_repo_root}/.local/bin/metals" -f

bootstrap_emacs="/opt/homebrew/opt/emacs-plus@30/Emacs.app/Contents/MacOS/Emacs"
GM_EMACS_SKIP_PACKAGES=0 "${bootstrap_emacs}" --batch -Q \
  -l "${bootstrap_repo_root}/early-init.el" \
  -l "${bootstrap_repo_root}/init.el"

"${bootstrap_emacs}" --batch -Q \
  --eval "(setq user-emacs-directory \"${bootstrap_repo_root}/\")" \
  --eval '(require (quote package))' \
  --eval '(package-initialize)' \
  --eval '(setq vterm-always-compile-module t)' \
  --eval '(require (quote vterm))'

"${bootstrap_emacs}" --batch -Q \
  -l "${bootstrap_repo_root}/early-init.el" \
  -l "${bootstrap_repo_root}/init.el" \
  --eval '(gm/treesit-install-all)'

echo "Bootstrap complete. Next run:"
echo "  ${bootstrap_repo_root}/bin/register-jdks-macos"
echo "  ${bootstrap_repo_root}/bin/cutover-emacs-macos"
echo "  ${bootstrap_repo_root}/bin/check"
