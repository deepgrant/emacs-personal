#!/usr/bin/env bash
set -euo pipefail

metals_repo_root="$(cd "$(dirname "$0")/.." && pwd)"
metals_java_home="$("${metals_repo_root}/bin/java-runtime-home" METALS_JDK)"
metals_binary="${metals_repo_root}/.local/bin/metals"

if [[ ! -x "${metals_java_home}/bin/java" ]]; then
  echo "The configured Metals JDK is missing at ${metals_java_home}" >&2
  exit 1
fi
if [[ ! -x "${metals_binary}" ]]; then
  echo "Metals is missing; run bin/bootstrap-macos" >&2
  exit 1
fi

export JAVA_HOME="${metals_java_home}"
export PATH="${JAVA_HOME}/bin:${PATH}"
exec "${metals_binary}" "$@"
