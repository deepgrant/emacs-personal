#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "This command is only for macOS." >&2
  exit 1
fi

jdk17_source="/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk"
jdk18_source="${HOME}/.local/share/jdks/jdk-18.0.2.jdk"
jdk21_source="/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk"

for jdk_source in "${jdk17_source}" "${jdk18_source}" "${jdk21_source}"; do
  if [[ ! -x "${jdk_source}/Contents/Home/bin/java" ]]; then
    echo "Missing JDK bundle: ${jdk_source}" >&2
    exit 1
  fi
done

if sudo -n true 2>/dev/null; then
  sudo ln -sfn "${jdk17_source}" /Library/Java/JavaVirtualMachines/openjdk-17.jdk
  sudo ln -sfn "${jdk18_source}" /Library/Java/JavaVirtualMachines/openjdk-18.jdk
  sudo ln -sfn "${jdk21_source}" /Library/Java/JavaVirtualMachines/openjdk-21.jdk
else
  osascript \
    -e 'on run argv' \
    -e 'do shell script "/bin/ln -sfn " & quoted form of item 1 of argv & " /Library/Java/JavaVirtualMachines/openjdk-17.jdk && /bin/ln -sfn " & quoted form of item 2 of argv & " /Library/Java/JavaVirtualMachines/openjdk-18.jdk && /bin/ln -sfn " & quoted form of item 3 of argv & " /Library/Java/JavaVirtualMachines/openjdk-21.jdk" with administrator privileges' \
    -e 'end run' \
    -- "${jdk17_source}" "${jdk18_source}" "${jdk21_source}"
fi

/usr/libexec/java_home -V 2>&1
