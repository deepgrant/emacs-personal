#!/usr/bin/env bash
set -euo pipefail

groovy_ls_repo_root="$(cd "$(dirname "$0")/.." && pwd)"
groovy_ls_java_home="/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
groovy_ls_jar="${groovy_ls_repo_root}/.cache/lsp/groovy-language-server-all.jar"

if [[ ! -x "${groovy_ls_java_home}/bin/java" ]]; then
  echo "OpenJDK 21 is missing at ${groovy_ls_java_home}" >&2
  exit 1
fi
if [[ ! -f "${groovy_ls_jar}" ]]; then
  echo "Groovy Language Server is missing; run bin/install-groovy-language-server" >&2
  exit 1
fi

export JAVA_HOME="${groovy_ls_java_home}"
export PATH="${JAVA_HOME}/bin:${PATH}"
exec "${JAVA_HOME}/bin/java" -jar "${groovy_ls_jar}" "$@"
